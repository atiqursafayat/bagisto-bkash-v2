parameters:
    paths:
        - src

    level: 5

    # These source files directly extend or heavily depend on Bagisto runtime classes
    # (Webkul\Payment, Webkul\Checkout, Webkul\Sales) that are not available as
    # standalone composer dependencies and cannot be resolved in CI without a full
    # Bagisto installation. They are excluded from static analysis.
    excludePaths:
        - src/Payment/Bkash.php
        - src/Services/BkashPaymentService.php

    ignoreErrors:
        # Bagisto core() global helper — registered at runtime via Bagisto service providers
        - message: '#Function core not found#'
          path: src/*

        # Bagisto Webkul\* classes are resolved via IoC at runtime, not composer packages
        - message: '#Class Webkul\\.*not found#'
          path: src/*

        # Http::bkash() macro is registered at runtime in BkashServiceProvider
        - message: '#Call to an undefined static method Illuminate\\Support\\Facades\\Http::bkash\(\)#'
          path: src/*

        # PHPDoc covariance on inherited Eloquent $fillable and $casts
        - message: '#PHPDoc type array of property .* is not covariant#'
          path: src/Models/*

        # Model properties defined via $fillable — PHPStan cannot infer dynamic properties
        - message: '#Access to an undefined property AtiqurSafayat\\Bkash\\Models\\BkashPayment::#'
          path: src/*

        # Bagisto repository constructor param types — resolved via IoC at runtime
        - message: '#has invalid type Webkul\\Sales\\Repositories\\#'
          path: src/*

        # Bagisto repository property types — resolved via IoC at runtime
        - message: '#has unknown class Webkul\\Sales\\Repositories\\#'
          path: src/*

        # BelongsTo with Webkul model class name — unknown standalone, valid at runtime
        - message: '#Parameter .* of method Illuminate\\Database\\Eloquent\\Model::belongsTo\(\) expects class-string#'
          path: src/Models/BkashPayment.php

    treatPhpDocTypesAsCertain: false
    reportUnmatchedIgnoredErrors: false
